# Lockfile is the contract; CI installs with --frozen-lockfile. Versions are saved exact.
auto-install-peers=true
strict-peer-dependencies=false
save-exact=true
# No lifecycle scripts from dependencies run by default (pnpm 10+). The allow-list is allowBuilds in
# pnpm-workspace.yaml, deny by default: true only for a package that genuinely needs a build step;
# oracledb, its first entry, is denied.
