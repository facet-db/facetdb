{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/generated",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnsafeOptionalChaining": "error"
      },
      "suspicious": { "noExplicitAny": "error" },
      "security": { "noDangerouslySetInnerHtml": "error" },
      "style": {
        "useNumberNamespace": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", "!../**/index.ts", "!../*", "!../../*", "!../../../*"],
                "message": "This import reaches inside another module. Import it through the module's barrel, ../<module>/index.ts: the barrel is the only cross-module door. Across packages, import the package by name."
              }
            ]
          }
        }
      },
      "complexity": { "useOptionalChain": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "packages/model/**",
        "packages/server/**",
        "packages/facetdb/src/e2e/listings.e2e.test.ts",
        "packages/facetdb/src/skill/skill.test.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
