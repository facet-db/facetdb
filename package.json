{
  "name": "facetdb-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB: AI answers as database columns.",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.18 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:types": "eslint .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:one": "./scripts/test-one.sh",
    "test:db": "./scripts/require-env.sh DATABASE_URL && pnpm -r --if-present run test:db",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "test:all": "pnpm run test && pnpm run test:db",
    "facetdb": "node --disable-warning=ExperimentalWarning packages/facetdb/src/cli/main.ts",
    "changelog": "./scripts/changelog.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
