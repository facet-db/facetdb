{
  "name": "@facetdb/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB HTTP surface: the check API for API sources, signed webhooks, and the review endpoints the dashboard and the terminal review share.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-db/facetdb.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@facetdb/core": "workspace:*",
    "@facetdb/postgres": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "zod": "4.6.7"
  }
}
