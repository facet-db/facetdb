{
  "name": "facetdb",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The facetdb package users install: the config DSL (facetdb, noul, choice, score), the plugin SDK under facetdb/plugin, the SDK client and the facetdb CLI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@facetdb/core": "workspace:*",
    "@facetdb/model": "workspace:*",
    "@facetdb/postgres": "workspace:*",
    "@facetdb/server": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.7"
  }
}
