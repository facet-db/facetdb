{
  "name": "facetdb",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The facetdb package users install: the config DSL (facetdb, noul, choice, score), the plugin SDK under facetdb/plugin, the SDK client and the facetdb CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-db/facetdb.git",
    "directory": "packages/facetdb"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "examples/*/facetdb.config.ts",
    "examples/*/seed.sql",
    "examples/*/seed-quick.sql",
    "examples/*/seed.js",
    "examples/*/seed-quick.js",
    "examples/*/*.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./schema": "./src/config/schema.ts"
  },
  "publishConfig": {
    "bin": {
      "facetdb": "./dist/cli/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "import": "./dist/plugin/index.js"
      },
      "./schema": {
        "types": "./dist/config/schema.d.ts",
        "import": "./dist/config/schema.js"
      }
    }
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry:build": "node --disable-warning=ExperimentalWarning src/plugin/registry-build.ts",
    "registry:build:offline": "node --disable-warning=ExperimentalWarning src/plugin/registry-build.ts --offline",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@facetdb/core": "workspace:*",
    "@facetdb/model": "workspace:*",
    "@facetdb/mongodb": "workspace:*",
    "@facetdb/mssql": "workspace:*",
    "@facetdb/mysql": "workspace:*",
    "@facetdb/postgres": "workspace:*",
    "@facetdb/server": "workspace:*",
    "@facetdb/sql-polling": "workspace:*",
    "@facetdb/sqlite": "workspace:*",
    "@facetdb/studio": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.7"
  }
}
