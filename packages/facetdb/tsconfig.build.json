{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/testing/**",
    "src/**/*-world.ts",
    "src/**/e2e/**",
    "src/**/fixtures/**",
    "src/cli/testing.ts",
    "src/plugin/registry-build.ts"
  ],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../model/tsconfig.build.json" },
    { "path": "../sql-polling/tsconfig.build.json" },
    { "path": "../postgres/tsconfig.build.json" },
    { "path": "../mysql/tsconfig.build.json" },
    { "path": "../mssql/tsconfig.build.json" },
    { "path": "../sqlite/tsconfig.build.json" },
    { "path": "../mongodb/tsconfig.build.json" },
    { "path": "../server/tsconfig.build.json" }
  ]
}
