{
  "name": "@facetdb/model",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB model providers: the TypeSafe /v1/systemone client with backoff, compatible providers behind a base URL, and the scripted fake used by tests and dry runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-db/facetdb.git",
    "directory": "packages/model"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@facetdb/core": "workspace:*",
    "zod": "4.6.7"
  }
}
