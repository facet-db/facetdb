{
  "name": "@facetdb/core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB core: question sets, thresholds, decisions, record statuses, the worker and the connector, action and model-provider contracts. Pure TypeScript; every side effect enters through an injected adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-db/facetdb.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
