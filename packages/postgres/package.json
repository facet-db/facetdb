{
  "name": "@facetdb/postgres",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB on Postgres: the trigger-and-jobs connector (inline columns or side table), the polling connector, and the FacetDB store for plugin and API sources. PGlite in development, any Postgres in production.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facet-db/facetdb.git",
    "directory": "packages/postgres"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "../../scripts/build-package.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@facetdb/core": "workspace:*",
    "@facetdb/sql-polling": "workspace:*",
    "postgres": "3.4.9"
  }
}
