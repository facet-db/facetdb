{
  "name": "@facetdb/mongodb",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "FacetDB on MongoDB 4.2 and later and Atlas through the mongodb driver: change streams on a replica set, with answers in a facetdb subdocument.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@facetdb/core": "workspace:*",
    "mongodb": "7.8.0"
  }
}
